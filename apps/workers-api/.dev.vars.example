# Single source of truth for local Worker auth secrets.
# Copy to .dev.vars (gitignored). Used by wrangler dev + `pnpm typegen`.
# Generate AUTH_SECRET with: openssl rand -base64 32

AUTH_SECRET=supersecret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: public production URL for OAuth redirects (defaults to request origin)
AUTH_PRODUCTION_URL=

# Optional: production Vite web app origin (trusted by Better Auth CORS)
WEB_APP_URL=
